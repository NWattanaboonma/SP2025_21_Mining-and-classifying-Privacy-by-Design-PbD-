# ============================================================================
#  TEMPLATE - this file is public. Copy it to `.env` and put your real keys
#  ONLY in `.env` (git-ignored, never zipped, never shared).
#
#      Windows:  copy .env.example .env
#      macOS/Linux: cp .env.example .env
#
#  The <...> values below are placeholders. Scripts treat them as "not set",
#  so nothing is ever sent to an API until you replace them in `.env`.
#
#  Optional: keep `.env` outside the project folder and point to it:
#      setx ENV_FILE "C:\Users\<you>\secrets\sp2025.env"
# ============================================================================

# --- Steps 02 / 03: GitHub REST API
#     Create at https://github.com/settings/tokens (fine-grained, public repositories, read-only)
#     Looks like: github_pat_XXXX... or ghp_XXXX...
GITHUB_TOKEN=<your-github-token>

# --- Step 05: Qdrant vector database
#     Local Docker (default, no key):  http://localhost:6333
#     Qdrant Cloud:  https://<cluster-id>.<region>.cloud.qdrant.io:6333  (+ QDRANT_API_KEY)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=<your-qdrant-api-key-or-leave-empty-for-local>

# --- Step 05: embedding providers (fill only the ones you use)
#     OpenAI  - https://platform.openai.com/api-keys      looks like: sk-proj-XXXX...
OPENAI_API_KEY=<your-openai-api-key>
#     Google  - https://aistudio.google.com/apikey        looks like: AIzaXXXX...
GEMINI_API_KEY=<your-gemini-api-key>
#     Cohere  - https://dashboard.cohere.com/api-keys
COHERE_API_KEY=<your-cohere-api-key>
